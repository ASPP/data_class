# AXES 
axes.labelcolor:    black
axes.facecolor:     white
axes.spines.right:  False
axes.spines.top:    False
axes.edgecolor:     black
axes.grid:          False
axes.axisbelow:     line 
axes.prop_cycle: cycler('color', ['darkgreen']) # default plot color is green

# LINES
lines.linewidth : 1 # was 1.9
lines.markersize: 3 # was 4.2

# FONTS
font.size :         12
font.family         : sans-serif
font.sans-serif     : Arial
svg.fonttype :        none
axes.titlesize    : 12
axes.labelsize    : 12
xtick.labelsize   : 12
ytick.labelsize   : 12
legend.fontsize   : 12
figure.titlesize  : 12

# FIGURE
figure.autolayout: True
figure.subplot.hspace: 0.4
figure.subplot.wspace: 0.4
savefig.facecolor: white
text.color: black

# TICKS
xtick.color: black
ytick.color: black

# BOXPLOT
boxplot.showfliers:  False
boxplot.showmeans:   False
boxplot.notch:       True
boxplot.patchartist: False
boxplot.boxprops.linewidth:     1.3
boxplot.boxprops.color:    4A0000
boxplot.capprops.linewidth:     1.3
boxplot.capprops.color:   4A0000
boxplot.whiskerprops.linewidth: 1.3
boxplot.whiskerprops.color:     4A0000
boxplot.medianprops.linewidth:    1.3
boxplot.medianprops.color:    4A0000

